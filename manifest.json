{
  "name": "Sistema Ameaça",
  "version": "1.0.0",
  "manifest_version": 1,
  "description": "Disparo visual temporário para tokens de personagem.",
  "author": "Onze1Onze",
  "homepage_url": "https://github.com/Onze1Onze/Ficha-de-Amea-a-",
  "icon": "https://onze1onze.github.io/Ficha-de-Amea-a-/icon.svg",
  "background_url": "https://onze1onze.github.io/Ficha-de-Amea-a-/background.html",
  "permissions": [
    {
      "name": "autoplay",
      "reason": "Reproduzir o efeito sonoro CC0 de disparo quando outro jogador dispara."
    }
  ],
  "action": {
    "title": "Disparo",
    "icon": "https://onze1onze.github.io/Ficha-de-Amea-a-/icon.svg",
    "popover": "https://onze1onze.github.io/Ficha-de-Amea-a-/index.html",
    "width": 360,
    "height": 390
  }
}
